---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const metadata = {
  title: 'Organigramă',
};
---

<Layout metadata={metadata}>
  <Hero>
    <Fragment slot="title">
      Organigramă
    </Fragment>
    <Fragment slot="subtitle">
      Organigrama Școlii Gimnaziale Christiana pentru anul școlar 2024-2025
    </Fragment>
  </Hero>

  <WidgetWrapper containerClass="max-w-4xl mx-auto pt-0 md:pt-0 lg:pt-0 -mt-8 md:-mt-12">
    <article class="prose prose-lg dark:prose-invert max-w-none px-4 md:px-8 space-y-6 text-center">
      <p>
        <a href="/images/uploads/2025/04/Organigrama-SGC_2024-2025.pdf" class="text-primary font-semibold hover:underline">
          Descarcă organigrama școlii pentru anul școlar 2024-2025 (PDF)
        </a>
      </p>
      <img 
        src="/images/uploads/2025/04/Organigrama-SGC-2024-2025-1-1024x721.png" 
        alt="Organigrama Școlii Gimnaziale Christiana 2024-2025"
        class="mx-auto rounded-lg shadow-lg"
      />
    </article>
  </WidgetWrapper>
</Layout>
