---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const metadata = {
  title: 'Documente utile',
};
---

<Layout metadata={metadata}>
  <Hero>
    <Fragment slot="title"> Documente utile </Fragment>
    <Fragment slot="subtitle"> Documente utile în cadrul programului „A Doua Șansă" </Fragment>
  </Hero>

  <WidgetWrapper containerClass="max-w-3xl mx-auto pt-0 md:pt-0 lg:pt-0 -mt-8 md:-mt-12">
    <div class="px-4 md:px-8">
      <p class="text-lg mb-6">
        Descărcați documentele necesare pentru înscriere și participarea în programul „A Doua Șansă":
      </p>
      <ul class="space-y-3">
        <li
          class="flex items-center gap-3 p-4 rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900"
        >
          <a
            href="/images/uploads/2021/03/cerere-inscriere-A-Doua-Sansa.pdf"
            class="text-primary font-semibold hover:underline"
          >
            Cerere de înscriere (descarcă PDF)
          </a>
        </li>
        <li
          class="flex items-center gap-3 p-4 rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900"
        >
          <a href="/images/uploads/2021/03/cerere-reinscriere.pdf" class="text-primary font-semibold hover:underline">
            Cerere de reînscriere (descarcă PDF)
          </a>
        </li>
        <li
          class="flex items-center gap-3 p-4 rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900"
        >
          <a href="/images/uploads/2021/03/Contract-educational.pdf" class="text-primary font-semibold hover:underline">
            Contract de școlarizare (descarcă PDF)
          </a>
        </li>
        <li
          class="flex items-center gap-3 p-4 rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900"
        >
          <span class="text-muted dark:text-slate-400"
            >Fișă individuală — nivel primar <em class="text-sm">(în curs de publicare)</em></span
          >
        </li>
        <li
          class="flex items-center gap-3 p-4 rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900"
        >
          <span class="text-muted dark:text-slate-400"
            >Fișă individuală — nivel gimnazial <em class="text-sm">(în curs de publicare)</em></span
          >
        </li>
        <li
          class="flex items-center gap-3 p-4 rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900"
        >
          <span class="text-muted dark:text-slate-400"
            >Chestionar de satisfacție pentru cursanți <em class="text-sm">(în curs de publicare)</em></span
          >
        </li>
      </ul>
    </div>
  </WidgetWrapper>
</Layout>
