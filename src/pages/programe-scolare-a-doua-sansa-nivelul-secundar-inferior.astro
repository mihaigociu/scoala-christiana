---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const metadata = {
  title: 'Programe școlare — A Doua Șansă — nivelul secundar inferior',
};
---

<Layout metadata={metadata}>
  <Hero>
    <Fragment slot="title"> Programe școlare — nivelul secundar inferior </Fragment>
  </Hero>

  <WidgetWrapper containerClass="max-w-4xl mx-auto pt-0 md:pt-0 lg:pt-0 -mt-8 md:-mt-12">
    <article class="prose prose-lg dark:prose-invert max-w-none px-4 md:px-8 space-y-6">
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-gray-100 dark:bg-slate-700">
              <th class="border border-gray-300 dark:border-slate-600 p-2 text-left w-12">Nr.</th>
              <th class="border border-gray-300 dark:border-slate-600 p-2 text-left">Disciplina</th>
              <th class="border border-gray-300 dark:border-slate-600 p-2 text-left w-32">Descarcă</th>
            </tr>
          </thead>
          <tbody>
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">1</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Limba și literatura română</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2"
                ><a
                  href="/images/uploads/2022/11/Programa-LIMBA-SI-LITERATURA-ROMANA-_A_doua_sansa_2011.pdf"
                  target="_blank">Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">2</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Limba engleză</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/Programa-LIMBA-ENGLEZA-_A_doua_sansa_2011.pdf" target="_blank"
                  >Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">3</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Limba franceză</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/Programa-LIMBA-FRANCEZA-_A_doua_sansa_2011.pdf" target="_blank"
                  >Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">4</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Matematică</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/4.-Programa-MATEMATICA_A_doua_sansa_2011.pdf" target="_blank"
                  >Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">5</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Științe</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/5.-Programa-STIINTE-_A_doua_sansa_2011.pdf" target="_blank"
                  >Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">6</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Cultură civică / Educație antreprenorială</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2"
                ><a
                  href="/images/uploads/2022/11/6.-Programa-CULTURA-CIVICA_EDUCATIE-ANTREPRENORIALA_A_doua_s.pdf"
                  target="_blank">Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">7</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Istorie</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/7.-Programa-ISTORIE-_A_doua_sansa_2011.pdf" target="_blank"
                  >Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">8</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Geografie</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/8.-Programa-GEOGRAFIE_A_doua_sansa_2011.pdf" target="_blank"
                  >Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">9</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Arte</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/9.-Programa-ARTE_A_doua_sansa_2011.pdf" target="_blank"
                  >Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">10</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Tehnologia informațiilor și comunicațiilor</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2"
                ><a
                  href="/images/uploads/2022/11/10.-Programa-TEHNOLOGIA-INFORMATIILOR-SI-A-COMUNICATIILOR__A.pdf"
                  target="_blank">Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">11</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Consiliere și orientare</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2"
                ><a
                  href="/images/uploads/2022/11/11.-Programa-CONSILIERE-SI-ORIENTARE_A_doua_sansa_2011-gimnazial.pdf"
                  target="_blank">Descarcă PDF</a
                ></td
              ></tr
            >
          </tbody>
        </table>
      </div>
    </article>
  </WidgetWrapper>
</Layout>
