---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const metadata = {
  title: 'Anul II secundar inferior',
};

const discipline = [
  { nr: 1, nume: 'Orientare școlară', ghid: null, modul: 'M2' },
  { nr: 2, nume: 'Limba și literatura română', ghid: { text: 'Descarcă ghid Limba și literatura română', href: 'https://drive.google.com/file/d/16sLrVUVlWqdVyAe91DQQV8yRhRh0KK3R/view?usp=sharing' }, modul: 'M2' },
  { nr: 3, nume: 'Limba franceză', ghid: null, modul: 'M2' },
  { nr: 4, nume: 'Limba engleză', ghid: { text: 'Descarcă ghid Limba engleză', href: 'https://drive.google.com/file/d/17sOtQNv73J2ctnKpKJIbLiFgoDeNHka9/view?usp=sharing' }, modul: 'M1' },
  { nr: 5, nume: 'Matematică', ghid: { text: 'Descarcă ghid Matematică', href: 'https://drive.google.com/file/d/1UDLiWSHshu97nhJ9epEcUiDq5vRzs3FL/view?usp=sharing' }, modul: 'M2' },
  { nr: 6, nume: 'Istorie', ghid: { text: 'Descarcă ghid Istorie', href: 'https://drive.google.com/file/d/1iL-7a6FFK-htXFa1oUZkkHfM91t1L3xE/view?usp=sharing' }, modul: 'M2' },
  { nr: 7, nume: 'Geografie', ghid: { text: 'Descarcă ghid Geografie', href: 'https://drive.google.com/file/d/1a2JG8d90KsUcoxJaRZzsYAHYSVjFSpgV/view?usp=sharing' }, modul: 'M2' },
  { nr: 8, nume: 'Consiliere', ghid: null, modul: 'M2' },
];
---

<Layout metadata={metadata}>
  <Hero>
    <Fragment slot="title">
      Anul II secundar inferior
    </Fragment>
  </Hero>

  <WidgetWrapper containerClass="max-w-4xl mx-auto pt-0 md:pt-0 lg:pt-0 -mt-8 md:-mt-12">
    <article class="prose prose-lg dark:prose-invert max-w-none px-4 md:px-8 space-y-6">
      <div class="flex items-center gap-3 rounded-lg border border-blue-200 dark:border-blue-800 bg-blue-50 dark:bg-blue-900/30 p-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-600 dark:text-blue-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <p class="m-0 text-sm">
          Fiecare portofoliu va conține, în mod obligatoriu, pagina de titlu —
          <a href="/images/uploads/2018/04/Pagina-de-titlu-portofoliu.docx" class="inline-flex items-center gap-1 font-semibold text-blue-600 dark:text-blue-400 underline">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            descarcă model
          </a>
        </p>
      </div>

      <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-slate-700">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-gray-200">
              <th class="p-3 text-left font-semibold w-16">Nr.</th>
              <th class="p-3 text-left font-semibold">Disciplina</th>
              <th class="p-3 text-left font-semibold">Ghid școlar</th>
              <th class="p-3 text-center font-semibold w-20">Modul</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
            {discipline.map((d, i) => (
              <tr class:list={[i % 2 === 1 && 'bg-gray-50 dark:bg-slate-800/50', 'hover:bg-blue-50 dark:hover:bg-slate-800 transition-colors']}>
                <td class="p-3 text-gray-500 dark:text-gray-400">{d.nr}</td>
                <td class="p-3 font-medium">{d.nume}</td>
                <td class="p-3">
                  {d.ghid ? (
                    <a href={d.ghid.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-blue-600 dark:text-blue-400 hover:underline">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                      Descarcă ghid
                    </a>
                  ) : (
                    <span class="text-gray-400 dark:text-gray-500">—</span>
                  )}
                </td>
                <td class="p-3 text-center">
                  <span class="inline-block rounded-full bg-gray-200 dark:bg-slate-600 px-2.5 py-0.5 text-xs font-medium">{d.modul}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <hr class="border-gray-200 dark:border-slate-700" />

      <div class="rounded-lg border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-900/20 p-5 space-y-3">
        <h3 class="m-0 text-base font-semibold flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
          Pregătire profesională
        </h3>
        <p class="m-0 text-sm">Modulele de pregătire profesională se desfășoară la <strong>Colegiul tehnic de comunicații „Augustin Maior"</strong> din Cluj-Napoca, strada Moților, nr. 78-80, jud. Cluj.</p>
        <div class="grid gap-2 sm:grid-cols-2">
          <div class="flex items-start gap-2 rounded-md bg-white dark:bg-slate-800 p-3 text-sm border border-amber-100 dark:border-amber-900">
            <span class="font-semibold text-amber-700 dark:text-amber-400">1.</span>
            <div>
              <p class="m-0 font-medium">Tehnologia lucrărilor electromecanice</p>
              <p class="m-0 text-xs text-gray-500 dark:text-gray-400">Instruire practică · sala 67 · prof. Badea Marius</p>
            </div>
          </div>
          <div class="flex items-start gap-2 rounded-md bg-white dark:bg-slate-800 p-3 text-sm border border-amber-100 dark:border-amber-900">
            <span class="font-semibold text-amber-700 dark:text-amber-400">2.</span>
            <div>
              <p class="m-0 font-medium">Desen tehnic industrial</p>
              <p class="m-0 text-xs text-gray-500 dark:text-gray-400">sala 58 · prof. Dogaru Maria</p>
            </div>
          </div>
        </div>
      </div>
    </article>
  </WidgetWrapper>
</Layout>
