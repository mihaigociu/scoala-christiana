---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const metadata = {
  title: 'Nivelul primar — Ghiduri școlare elevi',
};

const niveluri = [
  {
    nivel: 'Nivelul I',
    discipline: [
      { nume: 'Educație civică', href: 'https://drive.google.com/file/d/1Jrp9nnFKvWUYAyNrRQXVu-c5pIWnGYJr/view?usp=sharing' },
      { nume: 'Limba și literatura română', href: 'https://drive.google.com/file/d/1bW_Xl21mmY_BOnQigU_Ve3f9UWZuF0au/view?usp=sharing' },
      { nume: 'Matematică', href: 'https://drive.google.com/file/d/1PdpAAu-pGEnDf5FTELpo8ztvHEnJkV2F/view?usp=sharing' },
    ],
  },
  {
    nivel: 'Nivelul II',
    discipline: [
      { nume: 'Educație civică', href: 'https://drive.google.com/file/d/1Jrp9nnFKvWUYAyNrRQXVu-c5pIWnGYJr/view?usp=sharing' },
      { nume: 'Limba și literatura română', href: 'https://drive.google.com/file/d/1PQL_sik2L99o4kAQlRQDztS6Zsjx2x6Y/view?usp=sharing' },
      { nume: 'Matematică', href: 'https://drive.google.com/file/d/14NuDTLfAdScj-e5i6wceQ5SQjSB1TVfG/view?usp=sharing' },
    ],
  },
  {
    nivel: 'Nivelul III',
    discipline: [
      { nume: 'Educație civică', href: 'https://drive.google.com/file/d/1Jrp9nnFKvWUYAyNrRQXVu-c5pIWnGYJr/view?usp=sharing' },
      { nume: 'Limba și literatura română', href: 'https://drive.google.com/file/d/1sxDcnkEiEhODmt1wGg5Q9GFXa3q33U6g/view?usp=sharing' },
      { nume: 'Limba engleză', href: 'https://drive.google.com/file/d/16wF-ZXX3c1jV9Ia7fw8B-_Z5uHx4The5/view?usp=sharing' },
      { nume: 'Matematică', href: 'https://drive.google.com/file/d/1cVWIBhH_ZggDTEKkJL_UzNxq5RY4lA6q/view?usp=sharing' },
      { nume: 'Cunoașterea mediului', href: 'https://drive.google.com/file/d/1TMHoDZTdE5MaGyfmh7pK5s_b0IaVThNR/view?usp=sharing' },
    ],
  },
  {
    nivel: 'Nivelul IV',
    discipline: [
      { nume: 'Educație civică', href: 'https://drive.google.com/file/d/1Jrp9nnFKvWUYAyNrRQXVu-c5pIWnGYJr/view?usp=sharing' },
      { nume: 'Limba și literatura română', href: 'https://drive.google.com/file/d/1zKeQHfl37O6nypDUz7Zu9amfJt-vwhOM/view?usp=sharing' },
      { nume: 'Limba engleză', href: 'https://drive.google.com/file/d/1esa68v-N6WrsaFXryTkNKPgQlzQi4oHI/view?usp=sharing' },
      { nume: 'Matematică', href: 'https://drive.google.com/file/d/10pJ_egBfgyq0W_EXDECuAZhnPxGDvNuh/view?usp=sharing' },
      { nume: 'Istorie-Geografie', href: 'https://drive.google.com/file/d/1P-vO7P4OOyuMJftrfHgRC4_3xVmV7Tpi/view?usp=sharing' },
    ],
  },
];
---

<Layout metadata={metadata}>
  <Hero>
    <Fragment slot="title">
      Nivelul primar — Ghiduri școlare elevi
    </Fragment>
  </Hero>

  <WidgetWrapper containerClass="max-w-4xl mx-auto pt-0 md:pt-0 lg:pt-0 -mt-8 md:-mt-12">
    <div class="px-4 md:px-8">
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-gray-100 dark:bg-slate-700">
              <th class="border border-gray-300 dark:border-slate-600 p-3 text-left font-semibold w-12">Nr.</th>
              <th class="border border-gray-300 dark:border-slate-600 p-3 text-left font-semibold w-32">Nivelul de studii</th>
              <th class="border border-gray-300 dark:border-slate-600 p-3 text-left font-semibold">Disciplina</th>
              <th class="border border-gray-300 dark:border-slate-600 p-3 text-left font-semibold">Link descărcare</th>
            </tr>
          </thead>
          <tbody>
            {(() => {
              let nr = 0;
              return niveluri.flatMap((n) =>
                n.discipline.map((d, i) => {
                  nr++;
                  const nivelRoman = n.nivel.replace('Nivelul ', '');
                  return (
                    <tr class="hover:bg-gray-50 dark:hover:bg-slate-800/50">
                      <td class="border border-gray-300 dark:border-slate-600 p-3">{nr}</td>
                      {i === 0 && (
                        <td class="border border-gray-300 dark:border-slate-600 p-3 font-semibold align-middle bg-gray-50 dark:bg-slate-800/40" rowspan={n.discipline.length}>
                          {n.nivel}
                        </td>
                      )}
                      <td class="border border-gray-300 dark:border-slate-600 p-3">{d.nume}</td>
                      <td class="border border-gray-300 dark:border-slate-600 p-3">
                        <a href={d.href} target="_blank" rel="noopener" class="text-primary font-semibold hover:underline">
                          Ghid {d.nume} - Niv {nivelRoman}
                        </a>
                      </td>
                    </tr>
                  );
                })
              );
            })()}
          </tbody>
        </table>
      </div>
    </div>
  </WidgetWrapper>
</Layout>
