---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const metadata = {
  title: 'Structura anului școlar 2025-2026 — Programul „A Doua Șansă"',
};
---

<Layout metadata={metadata}>
  <Hero>
    <Fragment slot="title"> Structura anului școlar 2025-2026 </Fragment>
    <Fragment slot="subtitle"> Structura anului școlar pentru programul „A Doua Șansă" </Fragment>
  </Hero>

  <!-- NIVEL PRIMAR -->
  <WidgetWrapper containerClass="max-w-4xl mx-auto pt-0 md:pt-0 lg:pt-0 -mt-8 md:-mt-12">
    <div class="px-4 md:px-8">
      <h2 class="text-2xl font-bold mb-6">Nivelul primar — Programul „A Doua Șansă"</h2>

      <h3 class="text-lg font-semibold mb-3">Semestrul I — 16 săptămâni de cursuri</h3>
      <div class="overflow-x-auto mb-8">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-gray-100 dark:bg-slate-800">
              <th class="border border-gray-300 dark:border-slate-600 p-3 text-left font-semibold">Perioadă</th>
              <th class="border border-gray-300 dark:border-slate-600 p-3 text-left font-semibold">Interval</th>
              <th class="border border-gray-300 dark:border-slate-600 p-3 text-left font-semibold">Durata</th>
              <th class="border border-gray-300 dark:border-slate-600 p-3 text-left font-semibold">Săpt.</th>
            </tr>
          </thead>
          <tbody>
            <tr class="font-semibold bg-blue-50 dark:bg-blue-900/20">
              <td class="border border-gray-300 dark:border-slate-600 p-3">Cursuri</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">22 Septembrie 2025 – 24 Octombrie 2025</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">5 săptămâni</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">S1–5</td>
            </tr>
            <tr>
              <td class="border border-gray-300 dark:border-slate-600 p-3">Vacanță</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">25 Octombrie 2025 – 2 Noiembrie 2025</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">1 săptămână</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">—</td>
            </tr>
            <tr class="font-semibold bg-blue-50 dark:bg-blue-900/20">
              <td class="border border-gray-300 dark:border-slate-600 p-3">Cursuri</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">3 Noiembrie 2025 – 19 Decembrie 2025</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">7 săptămâni</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">S6–12</td>
            </tr>
            <tr>
              <td class="border border-gray-300 dark:border-slate-600 p-3">Vacanță iarnă</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">20 Decembrie 2025 – 11 Ianuarie 2026</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">3 săptămâni</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">—</td>
            </tr>
            <tr class="font-semibold bg-blue-50 dark:bg-blue-900/20">
              <td class="border border-gray-300 dark:border-slate-600 p-3">Cursuri</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">12 Ianuarie 2026 – 6 Februarie 2026</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">4 săptămâni</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">S13–16</td>
            </tr>
            <tr>
              <td class="border border-gray-300 dark:border-slate-600 p-3">Vacanță</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">7 Februarie 2026 – 15 Februarie 2026</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">1 săptămână</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">—</td>
            </tr>
            <tr class="bg-gray-100 dark:bg-slate-800 font-semibold">
              <td class="border border-gray-300 dark:border-slate-600 p-3" colspan="2">Total săptămâni cursuri</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3" colspan="2">16 săptămâni</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-lg font-semibold mb-3">Semestrul al II-lea — 16 săptămâni de cursuri</h3>
      <div class="overflow-x-auto mb-6">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-gray-100 dark:bg-slate-800">
              <th class="border border-gray-300 dark:border-slate-600 p-3 text-left font-semibold">Perioadă</th>
              <th class="border border-gray-300 dark:border-slate-600 p-3 text-left font-semibold">Interval</th>
              <th class="border border-gray-300 dark:border-slate-600 p-3 text-left font-semibold">Durata</th>
              <th class="border border-gray-300 dark:border-slate-600 p-3 text-left font-semibold">Săpt.</th>
            </tr>
          </thead>
          <tbody>
            <tr class="font-semibold bg-blue-50 dark:bg-blue-900/20">
              <td class="border border-gray-300 dark:border-slate-600 p-3">Cursuri</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">16 Februarie 2026 – 3 Aprilie 2026</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">7 săptămâni</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">S1–7</td>
            </tr>
            <tr>
              <td class="border border-gray-300 dark:border-slate-600 p-3">Vacanță primăvară</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">4 Aprilie 2026 – 19 Aprilie 2026</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">2 săptămâni</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">—</td>
            </tr>
            <tr class="font-semibold bg-blue-50 dark:bg-blue-900/20">
              <td class="border border-gray-300 dark:border-slate-600 p-3">Cursuri</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">20 Aprilie 2026 – 19 Iunie 2026</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">9 săptămâni</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">—</td>
            </tr>
            <tr class="bg-gray-100 dark:bg-slate-800 font-semibold">
              <td class="border border-gray-300 dark:border-slate-600 p-3" colspan="2">Total săptămâni cursuri</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3" colspan="2">16 săptămâni</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="space-y-2 text-sm text-muted dark:text-slate-400">
        <p>
          Programul „Școala Altfel" se va desfășura în perioada <strong class="text-gray-700 dark:text-slate-300"
            >15–19 Decembrie 2025</strong
          >.
        </p>
        <p>
          Programul „Săptămâna verde" se va desfășura în perioada <strong class="text-gray-700 dark:text-slate-300"
            >30 Martie – 3 Aprilie 2026</strong
          >.
        </p>
      </div>
    </div>
  </WidgetWrapper>

  <!-- NIVEL SECUNDAR INFERIOR -->
  <WidgetWrapper containerClass="max-w-4xl mx-auto">
    <div class="px-4 md:px-8">
      <h2 class="text-2xl font-bold mb-6">Nivelul secundar inferior — Programul „A Doua Șansă"</h2>

      <div class="overflow-x-auto mb-6">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-gray-100 dark:bg-slate-800">
              <th class="border border-gray-300 dark:border-slate-600 p-3 text-left font-semibold">Perioadă</th>
              <th class="border border-gray-300 dark:border-slate-600 p-3 text-left font-semibold">Interval</th>
              <th class="border border-gray-300 dark:border-slate-600 p-3 text-left font-semibold">Durata</th>
              <th class="border border-gray-300 dark:border-slate-600 p-3 text-left font-semibold">Săpt.</th>
            </tr>
          </thead>
          <tbody>
            <tr class="font-semibold bg-blue-50 dark:bg-blue-900/20">
              <td class="border border-gray-300 dark:border-slate-600 p-3">S0</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">22–26 Septembrie 2025</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">1 săptămână</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">S0</td>
            </tr>
            <tr class="font-semibold bg-blue-50 dark:bg-blue-900/20">
              <td class="border border-gray-300 dark:border-slate-600 p-3">Cursuri</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">29 Septembrie 2025 – 24 Octombrie 2025</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">4 săptămâni</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">S1–4</td>
            </tr>
            <tr>
              <td class="border border-gray-300 dark:border-slate-600 p-3">Vacanță</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">25 Octombrie 2025 – 2 Noiembrie 2025</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">1 săptămână</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">—</td>
            </tr>
            <tr class="font-semibold bg-blue-50 dark:bg-blue-900/20">
              <td class="border border-gray-300 dark:border-slate-600 p-3">Cursuri</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">3 Noiembrie 2025 – 19 Decembrie 2025</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">7 săptămâni</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">S5–11</td>
            </tr>
            <tr>
              <td class="border border-gray-300 dark:border-slate-600 p-3">Vacanță iarnă</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">20 Decembrie 2025 – 11 Ianuarie 2026</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">3 săptămâni</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">—</td>
            </tr>
            <tr class="font-semibold bg-blue-50 dark:bg-blue-900/20">
              <td class="border border-gray-300 dark:border-slate-600 p-3">Cursuri</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">12 Ianuarie 2026 – 6 Februarie 2026</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">4 săptămâni</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">S12–15</td>
            </tr>
            <tr>
              <td class="border border-gray-300 dark:border-slate-600 p-3">Vacanță</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">7 Februarie 2026 – 15 Februarie 2026</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">1 săptămână</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">—</td>
            </tr>
            <tr class="font-semibold bg-blue-50 dark:bg-blue-900/20">
              <td class="border border-gray-300 dark:border-slate-600 p-3">Cursuri</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">16 Februarie 2026 – 3 Aprilie 2026</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">7 săptămâni</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">S16–22</td>
            </tr>
            <tr>
              <td class="border border-gray-300 dark:border-slate-600 p-3">Vacanță primăvară</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">4 Aprilie 2026 – 19 Aprilie 2026</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">2 săptămâni</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">—</td>
            </tr>
            <tr class="font-semibold bg-blue-50 dark:bg-blue-900/20">
              <td class="border border-gray-300 dark:border-slate-600 p-3">Cursuri</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">20 Aprilie 2026 – 19 Iunie 2026</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">9 săptămâni</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">S23–31</td>
            </tr>
            <tr>
              <td class="border border-gray-300 dark:border-slate-600 p-3">Sesiune I examene</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">22 Iunie 2026 – 26 Iunie 2026</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">1 săptămână</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">—</td>
            </tr>
            <tr>
              <td class="border border-gray-300 dark:border-slate-600 p-3">Sesiune II examene</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">29 Iunie 2026 – 3 Iulie 2026</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">1 săptămână</td>
              <td class="border border-gray-300 dark:border-slate-600 p-3">—</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </WidgetWrapper>
</Layout>
