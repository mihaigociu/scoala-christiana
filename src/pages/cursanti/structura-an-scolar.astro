---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const metadata = {
  title: 'Structura anului școlar 2026-2027 — Programul „A Doua Șansă”',
};

// Rândurile cu `cursuri: true` sunt evidențiate (săptămâni de cursuri / S0)
const primarPartea1 = [
  { perioada: 'S.i.', interval: '7 – 11 Septembrie 2026', durata: '1 săptămână', sapt: 'S0', cursuri: true },
  { perioada: 'S.i.', interval: '14 – 18 Septembrie 2026', durata: '1 săptămână', sapt: 'S0', cursuri: true },
  {
    perioada: 'Cursuri',
    interval: '21 Septembrie – 23 Octombrie 2026',
    durata: '5 săptămâni',
    sapt: 'S1-S5',
    cursuri: true,
  },
  { perioada: 'Vacanță', interval: '24 – 30 Octombrie 2026', durata: '1 săptămână', sapt: '—' },
  {
    perioada: 'Cursuri',
    interval: '2 Noiembrie – 18 Decembrie 2026',
    durata: '7 săptămâni',
    sapt: 'S6-S12',
    cursuri: true,
  },
  { perioada: 'Vacanță', interval: '19 Decembrie 2026 – 8 Ianuarie 2027', durata: '3 săptămâni', sapt: '—' },
  {
    perioada: 'Cursuri',
    interval: '11 Ianuarie – 5 Februarie 2027',
    durata: '4 săptămâni',
    sapt: 'S13-16',
    cursuri: true,
  },
];

const primarPartea2 = [
  { perioada: 'Cursuri', interval: '8 – 12 Februarie 2027', durata: '1 săptămână', sapt: 'S1', cursuri: true },
  { perioada: 'Vacanță', interval: '15 – 19 Februarie 2027', durata: '1 săptămână', sapt: '—' },
  {
    perioada: 'Cursuri',
    interval: '22 Februarie – 23 Aprilie 2027',
    durata: '9 săptămâni',
    sapt: 'S2-S10',
    cursuri: true,
  },
  { perioada: 'Vacanță', interval: '26 Aprilie – 7 Mai 2027', durata: '2 săptămâni', sapt: '—' },
  { perioada: 'Cursuri', interval: '10 Mai – 18 Iunie 2027', durata: '6 săptămâni', sapt: 'S11-16', cursuri: true },
  { perioada: 'Vacanță', interval: '19 Iunie – 31 August 2027', durata: 'Vacanță', sapt: '—' },
];

const gimnazial = [
  { perioada: 'S0', interval: '14 – 18 Septembrie 2026', durata: '1 săptămână', sapt: '—', cursuri: true },
  {
    perioada: 'Cursuri',
    interval: '21 Septembrie – 23 Octombrie 2026',
    durata: '5 săptămâni',
    sapt: 'S1-5',
    cursuri: true,
  },
  { perioada: 'Vacanță', interval: '26 – 30 Octombrie 2026', durata: '1 săptămână', sapt: '—' },
  {
    perioada: 'Cursuri',
    interval: '2 Noiembrie – 22 Decembrie 2026',
    durata: '8 săptămâni',
    sapt: 'S6-13',
    cursuri: true,
  },
  { perioada: 'Vacanță', interval: '23 Decembrie 2026 – 8 Ianuarie 2027', durata: '2 săptămâni', sapt: '—' },
  {
    perioada: 'Cursuri',
    interval: '11 Ianuarie – 12 Februarie 2027',
    durata: '5 săptămâni',
    sapt: 'S14-18',
    cursuri: true,
  },
  { perioada: 'Vacanță', interval: '15 – 19 Februarie 2027', durata: '1 săptămână', sapt: '—' },
  {
    perioada: 'Cursuri',
    interval: '22 Februarie – 23 Aprilie 2027',
    durata: '9 săptămâni',
    sapt: 'S19-27',
    cursuri: true,
  },
  { perioada: 'Vacanță', interval: '26 – 30 Aprilie 2027', durata: '1 săptămână', sapt: '—' },
  { perioada: 'Cursuri', interval: '5 Mai – 18 Iunie 2027', durata: '7 săptămâni', sapt: 'S28-S34', cursuri: true },
  { perioada: 'Sesiune I examene', interval: '21 – 25 Iunie 2027', durata: '1 săptămână', sapt: '—' },
  { perioada: 'Sesiune II examene', interval: '28 Iunie – 2 Iulie 2027', durata: '1 săptămână', sapt: '—' },
];

const tabele = {
  primar: [
    { titlu: 'Partea I — Septembrie 2026 – Februarie 2027', randuri: primarPartea1, total: '16 săptămâni' },
    { titlu: 'Partea II — Februarie – Iunie 2027', randuri: primarPartea2, total: '16 săptămâni' },
  ],
  gimnazial: [{ titlu: '', randuri: gimnazial, total: '' }],
};

const pdf = {
  primar: '/images/uploads/2026/09/Structura-anului-scolar-2026-2027-Primar.pdf',
  gimnazial: '/images/uploads/2026/09/Structura-anului-scolar-2026-2027-Gimnaziu.pdf',
};

const cell = 'border border-gray-300 p-3';
const headCell = `${cell} text-left font-semibold`;
---

<Layout metadata={metadata}>
  <Hero>
    <Fragment slot="title"> Structura anului școlar 2026-2027 </Fragment>
    <Fragment slot="subtitle"> Structura anului școlar pentru programul „A Doua Șansă” </Fragment>
  </Hero>

  {
    (['primar', 'gimnazial'] as const).map((nivel, i) => (
      <WidgetWrapper
        containerClass={i === 0 ? 'max-w-4xl mx-auto pt-0 md:pt-0 lg:pt-0 -mt-8 md:-mt-12' : 'max-w-4xl mx-auto'}
      >
        <div class="px-4 md:px-8">
          <h2 class="text-2xl font-bold mb-6">
            {nivel === 'primar'
              ? 'Nivelul primar — Programul „A Doua Șansă”'
              : 'Nivelul gimnazial — secundar inferior — Programul „A Doua Șansă”'}
          </h2>

          {tabele[nivel].map((tabel) => (
            <>
              {tabel.titlu && <h3 class="text-lg font-semibold mb-3">{tabel.titlu}</h3>}
              <div class="overflow-x-auto mb-8">
                <table class="w-full text-sm border-collapse">
                  <thead>
                    <tr class="bg-gray-100">
                      <th class={headCell}>Perioadă</th>
                      <th class={headCell}>Interval</th>
                      <th class={headCell}>Durata</th>
                      <th class={headCell}>Săpt.</th>
                    </tr>
                  </thead>
                  <tbody>
                    {tabel.randuri.map((r) => (
                      <tr class={r.cursuri ? 'font-semibold bg-blue-50' : undefined}>
                        <td class={cell}>{r.perioada}</td>
                        <td class={cell}>{r.interval}</td>
                        <td class={cell}>{r.durata}</td>
                        <td class={cell}>{r.sapt}</td>
                      </tr>
                    ))}
                    {tabel.total && (
                      <tr class="bg-gray-100 font-semibold">
                        <td class={cell} colspan="2">
                          Total săptămâni cursuri
                        </td>
                        <td class={cell} colspan="2">
                          {tabel.total}
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </>
          ))}

          <div class="space-y-2 text-sm text-muted">
            <p>
              Programul „Școala Altfel” se va desfășura în perioada{' '}
              <strong class="text-gray-700">14-18 Decembrie 2026</strong>.
            </p>
            <p>
              Programul „Săptămâna verde” se va desfășura în perioada{' '}
              <strong class="text-gray-700">19-23 Aprilie 2027</strong>.
            </p>
            {nivel === 'primar' && (
              <p>
                Total săptămâni cursuri: <strong class="text-gray-700">32 săptămâni</strong>
              </p>
            )}
          </div>

          <p class="mt-6">
            <a href={pdf[nivel]} class="text-primary font-semibold hover:underline">
              Descarcă structura anului școlar 2026-2027 pentru nivelul {nivel} (PDF)
            </a>
          </p>
        </div>
      </WidgetWrapper>
    ))
  }
</Layout>
