---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const metadata = {
  title: 'Prevenirea și combaterea hărțuirii',
};
---

<Layout metadata={metadata}>
  <Hero>
    <Fragment slot="title"> Prevenirea și combaterea hărțuirii </Fragment>
    <Fragment slot="subtitle">
      Prevenirea și combaterea hărțuirii pe criteriul de sex, precum și a hărțuirii morale la locul de muncă
    </Fragment>
  </Hero>

  <WidgetWrapper containerClass="max-w-4xl mx-auto pt-0 md:pt-0 lg:pt-0 -mt-8 md:-mt-12">
    <article class="prose prose-lg dark:prose-invert max-w-none px-4 md:px-8 space-y-6">
      <p>
        Documente legislative privind prevenirea și combaterea hărțuirii pe criteriul de sex, precum și a hărțuirii
        morale la locul de muncă:
      </p>

      <ul class="space-y-4">
        <li>
          <a
            href="/images/uploads/2025/04/HG-970-din-12.10.2023-Metodologie-prev-si-combatere-hartuire.pdf"
            target="_blank"
            rel="noopener"
            class="text-primary font-semibold hover:underline"
          >
            HG nr. 970 din 12.10.2023
          </a>
          <span class="block text-gray-600 text-base">
            Pentru aprobarea Metodologiei privind prevenirea și combaterea hărțuirii pe criteriul de sex, precum și a
            hărțuirii morale la locul de muncă
          </span>
        </li>
        <li>
          <a
            href="/images/uploads/2025/04/LEGE-nr-202-din-19.04.2002-egalitate-de-sanse-si-tratament-barbat-si-femei.pdf"
            target="_blank"
            rel="noopener"
            class="text-primary font-semibold hover:underline"
          >
            Legea nr. 202 din 19.04.2002
          </a>
          <span class="block text-gray-600 text-base">
            Privind egalitatea de șanse și de tratament între femei și bărbați
          </span>
        </li>
        <li>
          <a
            href="/images/uploads/2025/04/HG-1.547-din-19.12.2022-aprob-Strategie-nationala-prom-egal-de-sanse.pdf"
            target="_blank"
            rel="noopener"
            class="text-primary font-semibold hover:underline"
          >
            HG nr. 1547 din 19.12.2022
          </a>
          <span class="block text-gray-600 text-base">
            Pentru aprobarea Strategiei naționale privind promovarea egalității de șanse și de tratament între femei și
            bărbați și prevenirea și combaterea violenței domestice pentru perioada 2022-2027
          </span>
        </li>
        <li>
          <a
            href="/images/uploads/2025/04/OUG-137-din-31.08.2000-prevenirea-si-sanctionarea-discriminarii.pdf"
            target="_blank"
            rel="noopener"
            class="text-primary font-semibold hover:underline"
          >
            OUG nr. 137 din 31.08.2000
          </a>
          <span class="block text-gray-600 text-base">
            Privind prevenirea și sancționarea tuturor formelor de discriminare
          </span>
        </li>
      </ul>
    </article>
  </WidgetWrapper>
</Layout>
