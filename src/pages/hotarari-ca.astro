      <h2>An școlar 2020-2021</h2>
      <ul class="space-y-2">
        <li>
          <a
            href="/images/uploads/2021/03/Hot-CA-nr-1.pdf"
            target="_blank"
            rel="noopener"
            class="text-primary hover:underline">Hotărârea nr. 1 din 07.09.2020</a
          >
