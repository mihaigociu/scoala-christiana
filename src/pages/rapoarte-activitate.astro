---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const metadata = {
  title: 'Rapoarte de activitate',
};
---

<Layout metadata={metadata}>
  <Hero>
    <Fragment slot="title">
      Rapoarte de activitate
    </Fragment>
    <Fragment slot="subtitle">
      Rapoarte de activitate — programul „A Doua Șansă"
    </Fragment>
  </Hero>

  <WidgetWrapper containerClass="max-w-4xl mx-auto pt-0 md:pt-0 lg:pt-0 -mt-8 md:-mt-12">
    <article class="prose prose-lg dark:prose-invert max-w-none px-4 md:px-8 space-y-6">
        <p>
          Rapoartele de activitate ale Școlii Gimnaziale Christiana pentru programul „A Doua Șansă":
        </p>

        <ul class="space-y-3">
          <li>
            <a href="/images/uploads/2025/04/Raport-de-activitate-Scoala-Gimn-Christiana-2023-2024.pdf" target="_blank" rel="noopener" class="text-primary font-semibold hover:underline">
              Descarcă raportul de activitate pentru anul școlar 2023-2024
            </a>
          </li>
          <li>
            <span class="text-gray-500">Raportul de activitate pentru anul școlar 2022-2023</span>
          </li>
          <li>
            <a href="/images/uploads/2023/03/Raport-de-activitate-Scoala-Gimn-Christiana-2021-2022.pdf" target="_blank" rel="noopener" class="text-primary font-semibold hover:underline">
              Descarcă raportul de activitate pentru anul școlar 2021-2022
            </a>
          </li>
          <li>
            <a href="/images/uploads/2023/03/Raport-de-activitate-Scoala-Gimn-Christiana-2020-2021.pdf" target="_blank" rel="noopener" class="text-primary font-semibold hover:underline">
              Descarcă raportul de activitate pentru anul școlar 2020-2021
            </a>
          </li>
          <li>
            <a href="/images/uploads/2023/03/Raport-de-activitate-Scoala-Gimn-Christiana-2019-2020.pdf" target="_blank" rel="noopener" class="text-primary font-semibold hover:underline">
              Descarcă raportul de activitate pentru anul școlar 2019-2020
            </a>
          </li>
        </ul>
    </article>
  </WidgetWrapper>
</Layout>
