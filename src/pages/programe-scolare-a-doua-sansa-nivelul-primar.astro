---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const metadata = {
  title: 'Programe școlare — A Doua Șansă — nivelul primar',
};
---

<Layout metadata={metadata}>
  <Hero>
    <Fragment slot="title"> Programe școlare — nivelul primar </Fragment>
  </Hero>

  <WidgetWrapper containerClass="max-w-4xl mx-auto pt-0 md:pt-0 lg:pt-0 -mt-8 md:-mt-12">
    <article class="prose prose-lg dark:prose-invert max-w-none px-4 md:px-8 space-y-6">
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-gray-100 dark:bg-slate-700">
              <th class="border border-gray-300 dark:border-slate-600 p-2 text-left w-12">Nr.</th>
              <th class="border border-gray-300 dark:border-slate-600 p-2 text-left">Disciplina</th>
              <th class="border border-gray-300 dark:border-slate-600 p-2 text-left w-20">Nivel</th>
              <th class="border border-gray-300 dark:border-slate-600 p-2 text-left w-32">Descarcă</th>
            </tr>
          </thead>
          <tbody>
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">1</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Consiliere și orientare</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2">I–IV</td><td
                class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/ADS-primar-Programa_Consiliere-si-orientare-2011.pdf" target="_blank"
                  >Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">2</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Cunoașterea mediului</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2">III</td><td
                class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/ADS-primar-Programa_Cunoasterea-mediului-2011.pdf" target="_blank"
                  >Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">3</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Limba engleză</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2">I–IV</td><td
                class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/ADS-primar-Programa_Engleza-2011.pdf" target="_blank">Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">4</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Istorie-Geografie</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2">IV</td><td
                class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/ADS-primar-Programa_Istorie-Geografie-2011.pdf" target="_blank"
                  >Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">5</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Științe</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2">IV</td><td
                class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/ADS-primar-Programa_Stiinte-2011.pdf" target="_blank">Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">6</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Tehnologia informației și comunicațiilor</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2">III–IV</td><td
                class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/ADS-primar-Programa_TIC-2011.pdf" target="_blank">Descarcă PDF</a></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">7</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Limba română</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2">I</td><td
                class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/ADS-Programa-Lb-romana-nivel-I-2011.pdf" target="_blank"
                  >Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">8</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Limba română</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2">II</td><td
                class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/ADS-Programa-Lb-romana-nivel-II-2011.pdf" target="_blank"
                  >Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">9</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Limba română</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2">III</td><td
                class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/ADS-Programa-Lb-romana-nivel-III-2011.pdf" target="_blank"
                  >Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">10</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Limba română</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2">IV</td><td
                class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/ADS-Programa-Lb-romana-nivel-IV-2011.pdf" target="_blank"
                  >Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">11</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Matematică</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2">I</td><td
                class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/ADS-primar-Programa_Matematica_nivel_I-2011.pdf" target="_blank"
                  >Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">12</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Matematică</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2">II</td><td
                class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/ADS-primar-Programa_Matematica_nivel_II-2011.pdf" target="_blank"
                  >Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">13</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Matematică</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2">III</td><td
                class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/ADS-primar-Programa_Matematica_nivel_III-2011.pdf" target="_blank"
                  >Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">14</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Matematică</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2">IV</td><td
                class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/ADS-primar-Programa_Matematica_nivel_IV-2011.pdf" target="_blank"
                  >Descarcă PDF</a
                ></td
              ></tr
            >
            <tr
              ><td class="border border-gray-300 dark:border-slate-600 p-2">15</td><td
                class="border border-gray-300 dark:border-slate-600 p-2">Limba rromani</td
              ><td class="border border-gray-300 dark:border-slate-600 p-2">I–IV</td><td
                class="border border-gray-300 dark:border-slate-600 p-2"
                ><a href="/images/uploads/2022/11/ADS-Programa_rromani_predare-romana-2011.pdf" target="_blank"
                  >Descarcă PDF</a
                ></td
              ></tr
            >
          </tbody>
        </table>
      </div>
    </article>
  </WidgetWrapper>
</Layout>
