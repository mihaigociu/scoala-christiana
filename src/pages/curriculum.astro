---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';

const metadata = {
  title: 'Curriculum — Programul „A Doua Șansă"',
};
---

<Layout metadata={metadata}>
  <Hero tagline="Programul A Doua Șansă">
    <Fragment slot="title"> Curriculum </Fragment>
    <Fragment slot="subtitle">
      Planul-cadru de învățământ și disciplinele studiate în cadrul programului „A Doua Șansă"
    </Fragment>
  </Hero>

  <div class="-mt-12 md:-mt-20">
    <section class="mx-auto max-w-7xl px-4 md:px-8 pb-16">
      <div class="prose prose-lg max-w-none mx-auto">
        <h2>Nivelul primar</h2>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr>
                <th colspan="6" class="bg-gray-200 text-center font-bold p-2 border border-gray-400">NIVELUL PRIMAR</th>
              </tr>
              <tr class="bg-gray-100">
                <th class="border border-gray-400 p-2 text-left">Aria curriculară</th>
                <th class="border border-gray-400 p-2 text-left">Disciplina</th>
                <th class="border border-gray-400 p-2 text-center">I</th>
                <th class="border border-gray-400 p-2 text-center">II</th>
                <th class="border border-gray-400 p-2 text-center">III</th>
                <th class="border border-gray-400 p-2 text-center">IV</th>
              </tr>
              <tr>
                <th colspan="2" class="border border-gray-400 p-1 text-center text-xs text-gray-500 font-normal"
                  >Nivelul / nr. ore / săptămână</th
                >
                <th class="border border-gray-400 p-1 text-center text-xs text-gray-500 font-normal" colspan="4"></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td rowspan="2" class="border border-gray-400 p-2 font-semibold align-top">I. Limbă și comunicare</td>
                <td class="border border-gray-400 p-2">Limba și literatura română</td>
                <td class="border border-gray-400 p-2 text-center">7</td>
                <td class="border border-gray-400 p-2 text-center">7</td>
                <td class="border border-gray-400 p-2 text-center">6</td>
                <td class="border border-gray-400 p-2 text-center">6</td>
              </tr>
              <tr>
                <td class="border border-gray-400 p-2">Limba modernă</td>
                <td class="border border-gray-400 p-2 text-center">1</td>
                <td class="border border-gray-400 p-2 text-center">1</td>
                <td class="border border-gray-400 p-2 text-center">2</td>
                <td class="border border-gray-400 p-2 text-center">2</td>
              </tr>
              <tr>
                <td rowspan="3" class="border border-gray-400 p-2 font-semibold align-top"
                  >II. Matematică și științele naturii</td
                >
                <td class="border border-gray-400 p-2">Matematică</td>
                <td class="border border-gray-400 p-2 text-center">5</td>
                <td class="border border-gray-400 p-2 text-center">5</td>
                <td class="border border-gray-400 p-2 text-center">4</td>
                <td class="border border-gray-400 p-2 text-center">4</td>
              </tr>
              <tr>
                <td class="border border-gray-400 p-2">Cunoașterea mediului</td>
                <td class="border border-gray-400 p-2 text-center">—</td>
                <td class="border border-gray-400 p-2 text-center">—</td>
                <td class="border border-gray-400 p-2 text-center">1</td>
                <td class="border border-gray-400 p-2 text-center">—</td>
              </tr>
              <tr>
                <td class="border border-gray-400 p-2">Științele naturii</td>
                <td class="border border-gray-400 p-2 text-center">—</td>
                <td class="border border-gray-400 p-2 text-center">—</td>
                <td class="border border-gray-400 p-2 text-center">—</td>
                <td class="border border-gray-400 p-2 text-center">1</td>
              </tr>
              <tr>
                <td rowspan="2" class="border border-gray-400 p-2 font-semibold align-top">III. Om și societate</td>
                <td class="border border-gray-400 p-2">Educație civică</td>
                <td class="border border-gray-400 p-2 text-center">1</td>
                <td class="border border-gray-400 p-2 text-center">1</td>
                <td class="border border-gray-400 p-2 text-center">1</td>
                <td class="border border-gray-400 p-2 text-center">1</td>
              </tr>
              <tr>
                <td class="border border-gray-400 p-2">Istorie-Geografie</td>
                <td class="border border-gray-400 p-2 text-center">—</td>
                <td class="border border-gray-400 p-2 text-center">—</td>
                <td class="border border-gray-400 p-2 text-center">—</td>
                <td class="border border-gray-400 p-2 text-center">2</td>
              </tr>
              <tr>
                <td class="border border-gray-400 p-2 font-semibold">IV. Arte</td>
                <td class="border border-gray-400 p-2">Educație plastică / Lucru manual</td>
                <td class="border border-gray-400 p-2 text-center">0</td>
                <td class="border border-gray-400 p-2 text-center">0</td>
                <td class="border border-gray-400 p-2 text-center">0</td>
                <td class="border border-gray-400 p-2 text-center">0</td>
              </tr>
              <tr>
                <td class="border border-gray-400 p-2 font-semibold">V. Educație fizică și sport</td>
                <td class="border border-gray-400 p-2">Educație fizică și sport</td>
                <td class="border border-gray-400 p-2 text-center">0</td>
                <td class="border border-gray-400 p-2 text-center">0</td>
                <td class="border border-gray-400 p-2 text-center">0</td>
                <td class="border border-gray-400 p-2 text-center">0</td>
              </tr>
              <tr>
                <td class="border border-gray-400 p-2 font-semibold">VI. Tehnologii</td>
                <td class="border border-gray-400 p-2">Tehnologia informației și comunicațiilor</td>
                <td class="border border-gray-400 p-2 text-center">—</td>
                <td class="border border-gray-400 p-2 text-center">—</td>
                <td class="border border-gray-400 p-2 text-center">1</td>
                <td class="border border-gray-400 p-2 text-center">1</td>
              </tr>
              <tr>
                <td rowspan="2" class="border border-gray-400 p-2 font-semibold align-top"
                  >VII. Consiliere și orientare</td
                >
                <td class="border border-gray-400 p-2">Consiliere și orientare</td>
                <td class="border border-gray-400 p-2 text-center">1</td>
                <td class="border border-gray-400 p-2 text-center">1</td>
                <td class="border border-gray-400 p-2 text-center">1</td>
                <td class="border border-gray-400 p-2 text-center">1</td>
              </tr>
              <tr>
                <td class="border border-gray-400 p-2">Discipline opționale (CDȘ)</td>
                <td class="border border-gray-400 p-2 text-center">2–3</td>
                <td class="border border-gray-400 p-2 text-center">2–3</td>
                <td class="border border-gray-400 p-2 text-center">2–3</td>
                <td class="border border-gray-400 p-2 text-center">2–3</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 class="mt-10">Nivelul secundar inferior</h2>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr>
                <th colspan="3" class="bg-gray-200 text-center font-bold p-2 border border-gray-400"
                  >NIVEL SECUNDAR INFERIOR</th
                >
              </tr>
              <tr class="bg-gray-100">
                <th class="border border-gray-400 p-2 text-left">Aria curriculară</th>
                <th class="border border-gray-400 p-2 text-left">Disciplina</th>
                <th class="border border-gray-400 p-2 text-left">Cadru didactic</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td rowspan="3" class="border border-gray-400 p-2 font-semibold align-top">Limbă și comunicare</td>
                <td class="border border-gray-400 p-2">Limba și literatura română</td>
                <td class="border border-gray-400 p-2">Prof. Silaghi Ioana</td>
              </tr>
              <tr>
                <td class="border border-gray-400 p-2">Limba franceză</td>
                <td class="border border-gray-400 p-2">Prof. Derevici Liliana</td>
              </tr>
              <tr>
                <td class="border border-gray-400 p-2">Limba engleză</td>
                <td class="border border-gray-400 p-2">Prof. Dicu Virgil</td>
              </tr>
              <tr>
                <td rowspan="2" class="border border-gray-400 p-2 font-semibold align-top"
                  >Matematică și științele naturii</td
                >
                <td class="border border-gray-400 p-2">Matematică</td>
                <td class="border border-gray-400 p-2">Prof. Mihuț Ioan</td>
              </tr>
              <tr>
                <td class="border border-gray-400 p-2">Științe</td>
                <td class="border border-gray-400 p-2">—</td>
              </tr>
              <tr>
                <td rowspan="3" class="border border-gray-400 p-2 font-semibold align-top">Om și societate</td>
                <td class="border border-gray-400 p-2">Cultură civică / Educație antreprenorială</td>
                <td class="border border-gray-400 p-2">Prof. Petruț Lioara</td>
              </tr>
              <tr>
                <td class="border border-gray-400 p-2">Istorie</td>
                <td class="border border-gray-400 p-2">Prof. Blanari Călin</td>
              </tr>
              <tr>
                <td class="border border-gray-400 p-2">Geografie</td>
                <td class="border border-gray-400 p-2">Prof. Jucan Delia</td>
              </tr>
              <tr>
                <td class="border border-gray-400 p-2 font-semibold">Arte</td>
                <td class="border border-gray-400 p-2">Educație plastică</td>
                <td class="border border-gray-400 p-2">Prof. Petruț Lioara</td>
              </tr>
              <tr>
                <td rowspan="4" class="border border-gray-400 p-2 font-semibold align-top">Tehnologii</td>
                <td class="border border-gray-400 p-2">Tehnologia informației și a comunicațiilor</td>
                <td class="border border-gray-400 p-2">Prof. Gârda Ioan</td>
              </tr>
              <tr>
                <td class="border border-gray-400 p-2">Cultură de specialitate și instruire practică săptămânală</td>
                <td class="border border-gray-400 p-2">Prof. Silaghi Corneliu</td>
              </tr>
              <tr>
                <td class="border border-gray-400 p-2">Stagii de pregătire practică</td>
                <td class="border border-gray-400 p-2">—</td>
              </tr>
              <tr>
                <td class="border border-gray-400 p-2">Consiliere</td>
                <td class="border border-gray-400 p-2">Prof. Mih Codruța</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
</Layout>
