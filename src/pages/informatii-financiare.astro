---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const metadata = {
  title: 'Informații financiare',
};
---

<Layout metadata={metadata}>
  <Hero>
    <Fragment slot="title"> Informații financiare </Fragment>
  </Hero>

  <WidgetWrapper containerClass="max-w-4xl mx-auto pt-0 md:pt-0 lg:pt-0 -mt-8 md:-mt-12">
    <article class="prose prose-lg dark:prose-invert max-w-none px-4 md:px-8 space-y-6">
      <p>Balanțele financiare anuale ale Școlii Gimnaziale Christiana:</p>

      <ul class="space-y-3">
        <li>
          <a href="/images/uploads/2024/03/BALANTA-L12_2023.pdf" class="text-primary font-semibold hover:underline"
            >Anul 2023 (PDF)</a
          >
        </li>
        <li>
          <a href="/images/uploads/2024/03/Balanta-L12-2022.pdf" class="text-primary font-semibold hover:underline"
            >Anul 2022 (PDF)</a
          >
        </li>
        <li>
          <a href="/images/uploads/2024/03/BALANTA-L12-2021.pdf" class="text-primary font-semibold hover:underline"
            >Anul 2021 (PDF)</a
          >
        </li>
        <li>
          <a
            href="/images/uploads/2021/03/Balanta-Decembrie-2020.pdf"
            class="text-primary font-semibold hover:underline">Anul 2020 (PDF)</a
          >
        </li>
        <li>
          <a
            href="/images/uploads/2021/03/Balanta-Decembrie-2019.pdf"
            class="text-primary font-semibold hover:underline">Anul 2019 (PDF)</a
          >
        </li>
        <li>
          <a
            href="/images/uploads/2021/03/Balanta-Decembrie-2018.pdf"
            class="text-primary font-semibold hover:underline">Anul 2018 (PDF)</a
          >
        </li>
        <li>
          <a
            href="/images/uploads/2021/03/Balanta-Decembrie-2017.pdf"
            class="text-primary font-semibold hover:underline">Anul 2017 (PDF)</a
          >
        </li>
        <li>
          <a
            href="/images/uploads/2021/03/Balanta-Decembrie-2016.pdf"
            class="text-primary font-semibold hover:underline">Anul 2016 (PDF)</a
          >
        </li>
      </ul>
    </article>
  </WidgetWrapper>
</Layout>
